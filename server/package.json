{
  "name": "video-editor-server",
  "version": "1.0.0",
  "description": "Backend for the 9:16 video editor - trims and center-crops videos to 1080x1920 using FFmpeg",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "prestart": "node scripts/setup_ytdlp.js",
    "start": "node index.js",
    "predev": "node scripts/setup_ytdlp.js",
    "dev": "node index.js",
    "test": "node scripts/smoke_all.js",
    "test:unit": "node --test test/youtube.test.js test/exportConfig.test.js",
    "setup:ytdlp": "node scripts/setup_ytdlp.js",
    "update:ytdlp": "node scripts/setup_ytdlp.js --force"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0"
  }
}
